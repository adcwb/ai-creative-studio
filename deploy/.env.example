# Optional infrastructure only; replace these local values before starting.
POSTGRES_PASSWORD=replace-local-demo-password
MINIO_ROOT_USER=studio-local
MINIO_ROOT_PASSWORD=replace-local-demo-password

# Dedicated avatar execution (requires appropriately licensed operator engine).
DIGITAL_HUMAN_LICENSE_ACK=false
DIGITAL_HUMAN_PHOTO_COMMAND=
DIGITAL_HUMAN_PHOTO_MODEL=
DIGITAL_HUMAN_PHOTO_PROTOCOL=json-v1
DIGITAL_HUMAN_PHOTO_TIMEOUT_SECONDS=120
LIP_SYNC_COMMAND=
LIP_SYNC_MODEL=
LIP_SYNC_PROTOCOL=json-v1
LIP_SYNC_TIMEOUT_SECONDS=120

# Dedicated cloud avatar; disabled unless provider, license, private bridge and exact space IDs are configured.
DIGITAL_HUMAN_PHOTO_PROVIDER=local
DIGITAL_HUMAN_CLOUD_WORKSPACE=
DIGITAL_HUMAN_CLOUD_API_KEY=
DIGITAL_HUMAN_CLOUD_TENANTS=
DIGITAL_HUMAN_CLOUD_RESOLUTION=480P
