  "components": {
    "schemas": {
      "Task": {
        "type": "object",
        "required": [
          "id",
          "space_id",
          "prompt",
          "kind",
          "status",
          "progress",
          "provider",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "space_id": {
            "type": "string",
            "enum": [
              "personal-demo",
              "team-demo"
            ]
          },
          "prompt": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "poster",
              "portrait"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "succeeded",
              "failed"
            ]
          },
          "progress": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "provider": {
            "type": "string",
            "enum": [
              "mock-svg"
            ]
          },
          "result_url": {
            "type": "string"
          },
          "error": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Asset": {
        "type": "object",
        "required": [
          "id",
          "space_id",
          "task_id",
          "prompt",
          "kind",
          "provider",
          "result_url",
          "created_at"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "space_id": {
            "type": "string",
            "enum": [
              "personal-demo",
              "team-demo"
            ]
          },
          "prompt": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "poster",
              "portrait"
            ]
          },
          "provider": {
            "type": "string",
            "enum": [
              "mock-svg"
            ]
          },
          "result_url": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "task_id": {
            "type": "string"
          }
        }
      },
      "CreateTask": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "prompt",
          "kind"
        ],
        "properties": {
          "prompt": {
            "type": "string",
            "minLength": 3,
            "maxLength": 1000,
            "description": "去除两端空白后按 Unicode 字符计数；包含 [mock-fail] 可触发可复现的模拟失败。"
          },
          "kind": {
            "type": "string",
            "enum": [
              "poster",
              "portrait"
            ]
          }
        }
      },
      "Space": {
        "type": "object",
        "required": [
          "id",
          "name",
          "type",
          "owner_id"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "personal",
              "team"
            ]
          },
          "owner_id": {
            "type": "string"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
