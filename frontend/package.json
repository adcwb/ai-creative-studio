{
  "name": "ai-creative-studio-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run src",
    "test:e2e": "playwright test",
    "test:routing": "playwright test --config playwright.routing.config.ts",
    "test:gateway": "node ../scripts/gateway_browser_check.mjs"
  },
  "dependencies": {
    "@met4citizen/talkinghead": "1.8.2",
    "@xyflow/react": "12.12.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-router-dom": "7.18.5",
    "three": "0.186.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@playwright/test": "1.56.1",
    "@types/node": "24.10.1",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.2.5",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "eslint": "9.39.1",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.24",
    "globals": "16.5.0",
    "pngjs": "7.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
