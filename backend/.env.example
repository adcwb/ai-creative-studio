HTTP_ADDR=127.0.0.1:8080
FRONTEND_ORIGIN=http://localhost:5173
DATA_DIR=./data
# Default is local SVG simulation. Real mode is optional and may incur costs.
# Production uses the fixed official OpenAI endpoint; no custom base URL.
IMAGE_PROVIDER=mock-svg
# Required only for IMAGE_PROVIDER=openai-images. Never put a real key in Git.
OPENAI_API_KEY=
