HTTP_ADDR=127.0.0.1:8080
FRONTEND_ORIGIN=http://localhost:5173
DATA_DIR=./data
# Safe local defaults. No remote provider is enabled or tested.
IMAGE_PROVIDER=mock-svg
TEXT_PROVIDER=mock-text
SPEECH_PROVIDER=
VIDEO_PROVIDER=
# Real adapters REQUIRE an explicit account-enabled model, never guessed defaults.
# IMAGE_PROVIDER: openai-images | gemini-images | ark-images | jimeng-images
# TEXT_PROVIDER: openai-text | anthropic-text | gemini-text | ark-text | minimax-text
# SPEECH_PROVIDER: openai-speech | minimax-speech
# VIDEO_PROVIDER: openai-video | ark-video
IMAGE_MODEL=
TEXT_MODEL=
SPEECH_MODEL=
VIDEO_MODEL=
# MiniMax speech requires an explicitly selected authorized voice.
SPEECH_VOICE=
# Jimeng signed CV API uses req_key plus its own credentials, not an Ark key.
JIMENG_REQ_KEY=
# Never put real credentials in Git, frontend configuration, logs or chat.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
ARK_API_KEY=
MINIMAX_API_KEY=
JIMENG_ACCESS_KEY=
JIMENG_SECRET_KEY=
