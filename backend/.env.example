HTTP_ADDR=127.0.0.1:8080
FRONTEND_ORIGIN=http://localhost:5173
DATA_DIR=./data
# Safe local defaults. No remote provider is enabled or validated.
IMAGE_PROVIDER=mock-svg
TEXT_PROVIDER=mock-text
# Empty speech/video/ASR means unavailable, not simulated model output.
# Uploaded media and explicitly labelled synthetic demo remain usable locally.
SPEECH_PROVIDER=
VIDEO_PROVIDER=
ASR_PROVIDER=
# Real adapters REQUIRE explicit account-enabled models; no guessed defaults.
# TEXT_PROVIDER: openai-text | anthropic-text | gemini-text | ark-text | minimax-text
# Vision uses this same text provider/model; choose a model with image-input support.
# IMAGE_PROVIDER: openai-images | gemini-images | gemini-interactions-images |
#                 ark-images | jimeng-images | minimax-images
# gemini-images uses generateContent; gemini-interactions-images uses Interactions.
# SPEECH_PROVIDER: openai-speech | gemini-speech | bytedance-speech | minimax-speech
# VIDEO_PROVIDER: openai-video | gemini-video | ark-video | minimax-video
# ASR_PROVIDER: openai-asr; current timestamp contract requires ASR_MODEL=whisper-1.
# Text estimation is local, does not identify speech, and does not use ASR_PROVIDER.
IMAGE_MODEL=
TEXT_MODEL=
SPEECH_MODEL=
VIDEO_MODEL=
ASR_MODEL=
# Gemini, MiniMax and ByteDance speech require an explicit authorized voice.
# For bytedance-speech, SPEECH_MODEL is the X-Api-Resource-Id, not an Ark model.
SPEECH_VOICE=
# Jimeng public signed CV API uses req_key plus its own credentials, not an Ark key.
# Only documented req_key values for the implemented image protocol are usable.
JIMENG_REQ_KEY=
# Never put real credentials in Git, frontend configuration, logs or chat.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
ARK_API_KEY=
MINIMAX_API_KEY=
BYTEDANCE_SPEECH_API_KEY=
JIMENG_ACCESS_KEY=
JIMENG_SECRET_KEY=

# Iteration 7 safe defaults. Explicit demo is local-only and has no authorization.
AUTH_MODE=secure
AUTH_ALLOW_REGISTRATION=false
AUTH_COOKIE_SECURE=true
# Local HTTP development only: explicitly set cookie secure false and registration true.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=
# Optional operator-only literal loopback listener; never proxy publicly.
METRICS_ADDR=
# Adapters disabled; no models, credentials or network resources provisioned.
MUSIC_PROVIDER=
MUSIC_MODEL=
MUSIC_EXISTING_ACCOUNT_ACK=false
FORCED_ALIGNMENT_COMMAND=
FORCED_ALIGNMENT_MODEL=
LIP_SYNC_COMMAND=
LIP_SYNC_MODEL=
SOUND_EFFECT_COMMAND=
SOUND_EFFECT_MODEL=
